+/// JSON Lines is deliberately separate from diagnostics on stderr.
+fn emit_json(value: serde_json::Value) {
+    println!("{value}");
+    let _ = io::stdout().flush();
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Decision {
+    id: u64,
+    accept: bool,
+}
+
+async fn receiver_json(
+    mut events: tokio::sync::mpsc::Receiver<ReceiverEvent>,
+) -> io::Result<ExitCode> {
+    let mut pending: std::collections::HashMap<u64, owly_airdrop::driver::receiver::Request> =
+        std::collections::HashMap::new();
+    let mut stdin = tokio::io::BufReader::new(tokio::io::stdin()).lines();
+    emit_json(serde_json::json!({"event":"ready"}));
+    loop {
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => return Ok(ExitCode::SUCCESS),
+            line = stdin.next_line() => {
+                let Some(line) = line? else { return Ok(ExitCode::SUCCESS) };
+                match serde_json::from_str::<Decision>(&line) {
+                    Ok(answer) => {
+                        if let Some(request) = pending.remove(&answer.id) {
+                            if answer.accept { request.accept(); } else { request.decline(); }
+                        }
+                    }
+                    Err(e) => eprintln!("invalid decision: {e}"),
+                }
+            }
+            event = events.recv() => {
+                let Some(event) = event else { return Ok(ExitCode::SUCCESS) };
+                match event {
+                    ReceiverEvent::Discovered { .. } => {},
+                    ReceiverEvent::Request(request) => {
+                        let items: Vec<String> = match &request.ask.offer {
+                            Offer::Files(files) => files.iter().map(|f| f.name.clone()).collect(),
+                            Offer::Urls(urls) => urls.clone(),
+                        };
+                        emit_json(serde_json::json!({"event":"request", "id":request.id,
+                            "sender":request.ask.sender_computer_name, "items":items, "timeout":15}));
+                        pending.insert(request.id, request);
+                    }
+                    ReceiverEvent::Withdrawn { id } => {
+                        pending.remove(&id);
+                        emit_json(serde_json::json!({"event":"withdrawn", "id":id}));
+                    }
+                    ReceiverEvent::Received { id, paths } => {
+                        emit_json(serde_json::json!({"event":"received", "id":id, "paths":paths}));
+                    }
+                    ReceiverEvent::Urls { id, urls } => {
+                        emit_json(serde_json::json!({"event":"urls", "id":id, "urls":urls}));
+                    }
+                    ReceiverEvent::Failed { id, reason } => {
+                        pending.remove(&id);
+                        emit_json(serde_json::json!({"event":"failed", "id":id, "reason":reason}));
+                    }
+                }
+            }
+        }
+    }
+}
